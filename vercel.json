{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "app/api/sessions/[id]/start/route.ts":      { "maxDuration": 30 },
    "app/api/sessions/[id]/end/route.ts":         { "maxDuration": 30 },
    "app/api/sessions/[id]/evaluate/route.ts":    { "maxDuration": 60 },
    "app/api/targets/[id]/reconstruct/route.ts":  { "maxDuration": 60 },
    "app/api/documents/upload/route.ts":          { "maxDuration": 60 },
    "app/api/documents/embed/route.ts":           { "maxDuration": 60 },
    "app/api/reports/[id]/pdf/route.ts":          { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
