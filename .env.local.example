# =============================================================================
# Rehearsal — copy to .env.local and fill values
# Guides: docs/CONFIG.md  |  Google: docs/GOOGLE_AUTH.md  |  npm run setup:check
# =============================================================================

# --- Auth dev bypass (set false when testing Google / magic link) ---
DISABLE_AUTH=false

# --- App URL (required — OAuth redirect after Google sign-in) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (one-time — for npm run configure:google-auth) ---
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Google OAuth (optional in this file — REQUIRED in Supabase Dashboard) ---
# 1. Google Cloud → OAuth client (Web)
# 2. Redirect URI: https://YOUR_REF.supabase.co/auth/v1/callback
# 3. Paste Client ID + Secret into Supabase → Authentication → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM (reconstruct, embed, evaluate, reports) ---
# gemini (default) or openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_DEMO_MODE=false
ANTHROPIC_API_KEY=

# --- Beyond Presence (required for live avatar sessions) ---
BEY_API_KEY=
BEY_AGENT_ID=
BEY_WEBHOOK_SECRET=

# --- Jina Reader (recommended — URL scraping) ---
JINA_API_KEY=

# --- Optional: database CLI ---
DATABASE_URL=

# --- Optional: email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rehearsal <onboarding@resend.dev>

# --- Optional: analytics & errors ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# --- Optional: billing (post-MVP) ---
STRIPE_SECRET_KEY=
