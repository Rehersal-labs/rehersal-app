# =============================================================================
# Rehearsal — copy to .env.local and fill values
# Guides: docs/CONFIG.md  |  Google auth: docs/GOOGLE_AUTH.md
# Run `npm run setup:check` to verify configuration before starting.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# DEV ONLY — auth bypass
# Set to `false` in staging and production. NEVER deploy with DISABLE_AUTH=true.
# ─────────────────────────────────────────────────────────────────────────────
DISABLE_AUTH=false

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — App URL
# Used for OAuth redirect URIs. Must match Supabase redirect allow-list.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Supabase
# Get from: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # Server-side only. NEVER expose to browser.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — LLM (at least one provider must be configured)
# Used for: target reconstruction, document embedding, session evaluation, reports.
# LLM_PROVIDER must be "gemini" or "openai".
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_DEMO_MODE=false              # Set true to skip real LLM calls (returns stub data)

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Beyond Presence (live AI avatar sessions)
# Get from: https://app.beyondpresence.ai → API Keys
# BEY_WEBHOOK_SECRET: set in Beyond Presence dashboard → Webhook → Secret
# ─────────────────────────────────────────────────────────────────────────────
BEY_API_KEY=
BEY_AGENT_ID=
BEY_WEBHOOK_SECRET=              # Mandatory — webhooks rejected if not set

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Google OAuth (configured in Supabase, not here)
# 1. Google Cloud → OAuth client (Web)
# 2. Redirect URI: https://YOUR_REF.supabase.co/auth/v1/callback
# 3. Paste into Supabase → Authentication → Providers → Google
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Supabase CLI (one-time, for `npm run configure:google-auth`)
# https://supabase.com/dashboard/account/tokens
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Jina Reader (URL scraping for target reconstruction)
# Without this, scraping falls back to fetch (slower, more blocked)
# ─────────────────────────────────────────────────────────────────────────────
JINA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Email (team invites)
# Without RESEND_API_KEY, invites are logged but not emailed.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rehearsal <noreply@yourdomain.com>

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Analytics & error monitoring
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Health check
# Set a secret token so /api/health is not publicly readable.
# Pass as: GET /api/health  Header: x-health-token: <value>
# ─────────────────────────────────────────────────────────────────────────────
HEALTH_CHECK_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Database CLI
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Billing (post-MVP)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Anthropic (if using Claude for specific features)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
